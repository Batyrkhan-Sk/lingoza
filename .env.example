# ─── Database ────────────────────────────────────────────────────────────────
# Postgres everywhere. Start the local one with:
#   docker compose -f docker-compose.dev.yml up -d
DATABASE_URL="postgresql://lingoza:lingoza@localhost:5434/lingoza_dev?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Any long random string. Used to sign session JWTs.
JWT_SECRET="change-me-to-a-long-random-string"

# ─── AI: primary provider (Google Gemini Flash) ──────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Set this to the exact Flash revision you want to run against.
# "gemini-flash-latest" is an alias that always resolves to the current Flash.
GEMINI_MODEL="gemini-flash-latest"

# ─── AI: fallback provider (Groq) ────────────────────────────────────────────
# Used automatically whenever Gemini errors, rate-limits or times out.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# If both providers are unavailable, the engine falls back to deterministic
# rule-based feedback so every screen keeps working offline.

# ─── Authentic media (optional) ──────────────────────────────────────────────
# Free key from https://www.themoviedb.org/settings/api — enables films and
# cartoons. Wikipedia, music previews, podcasts and public-domain books all
# work without it.
TMDB_API_KEY=""

# Lyrics display. Leave empty unless you hold display rights from the
# rightsholder or their agent — without it lyrics are read for analysis and
# never printed. Set it to the credit line your licence requires; it is shown
# on every page of lyrics the bot sends. LYRICS_DISPLAY_MAX_LINES caps how
# much of a work is shown, for a licence that covers an excerpt.
LYRICS_DISPLAY_ATTRIBUTION=
LYRICS_DISPLAY_MAX_LINES=

# ─── Telegram bot ────────────────────────────────────────────────────────────
# Create a bot with @BotFather, then register the webhook:
#   npm run telegram:register --workspace @lingoza/api
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET="change-me-too"
# Public HTTPS base URL of the API (ngrok/tunnel in dev).
PUBLIC_API_URL="http://localhost:4000"

# Daily study reminders sent by the bot (three a day by default, at hours each
# learner picks with /remind). Set REMINDERS=off to silence them everywhere —
# e.g. when an external scheduler calls `npm run reminders:run` instead.
REMINDERS="on"
REMINDER_INTERVAL_MINUTES="10"

# ─── Servers ─────────────────────────────────────────────────────────────────
PORT=4000
WEB_ORIGIN="http://localhost:5173"
VITE_API_URL="http://localhost:4000"
